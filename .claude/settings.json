{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/bin/taintguard",
            "args": ["hook"],
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/bin/taintguard",
            "args": ["hook"],
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}